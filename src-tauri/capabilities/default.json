{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "窗口基础能力 + SQLite 本地持久化（对局日志 / 战绩 / 设置）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close"
  ]
}
